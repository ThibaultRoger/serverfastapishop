# Copier en .env (jamais commité) puis renseigner.

# Connexion à la base existante (obligatoire).
#   - base sur un autre serveur :       postgresql://utilisateur:motdepasse@serveur:5432/base
#   - base installée sur cette machine : postgresql://utilisateur:motdepasse@host.docker.internal:5432/base
#     (PostgreSQL doit alors écouter sur l'interface Docker : listen_addresses et pg_hba.conf)
# Le compte a besoin de SELECT, INSERT, UPDATE, DELETE sur les tables exposées et USAGE sur les séquences.
DATABASE_URL=postgresql://utilisateur:motdepasse@serveur:5432/base

# Port de l'API sur la machine ; 0.0.0.0 pour l'ouvrir au réseau local
API_PORT=8000
API_BIND=127.0.0.1
